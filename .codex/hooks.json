{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/scripts/claude-hooks/codex-adapter.py\" bash",
            "timeout": 30,
            "statusMessage": "Checking hard rules..."
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/scripts/claude-hooks/codex-adapter.py\" write",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/scripts/claude-hooks/codex-adapter.py\" session",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
