# Copy to `.env` for a local deployment. Do not commit the populated file.

# Required for browser/API sessions. Use a long, random value in every deployment.
JWT_SECRET=

# Optional: shared password for a fresh DB's seeded users. Leave unset once
# Telegram/Google login is live for this trip — each participant then gets an
# independent random password instead, and password login stays unavailable
# for them until they sign in another way and set their own from the avatar
# screen. Only set this for local/dev convenience or a deliberate operator
# choice; never a value visible in source control or shared across trips.
SEED_PASSWORD=

# Optional service-account integration. HERMES_API_KEY is the shared secret
# an AI agent (or the trip-mcp bridge acting on the site's own behalf) presents
# as X-API-Key to act as the trip's system "hermes" user — see mcp/README.md.
HERMES_API_KEY=

# Optional — lets the "Extract Details with AI" button on Add Booking work.
# Base URL of the trip's own trip-mcp bridge (mcp/mcp.js), e.g.
# http://192.168.1.50:3001. mcp/mcp.js also needs its own HERMES_EXTRACT_PROFILE
# set in its .env, pointing at a dedicated, tools-disabled Hermes profile —
# never your interviewer/companion profile — see mcp/README.md.
HERMES_URL=

# Optional Google login.
GOOGLE_CLIENT_ID=

# Optional — lets people on the trip connect their own Claude or ChatGPT at
# <PUBLIC_ORIGIN>/mcp, signing in with their site login (OAuth): organizers
# read and write, everyone else read only. Off unless both are set;
# PUBLIC_ORIGIN is this trip's public https origin with no path. Also requires
# JWT_SECRET to be set. See mcp/README.md, "Trip connector".
TRIP_MCP_ENABLED=
PUBLIC_ORIGIN=

# Optional: how many proxies between the visitor and this server APPEND the
# address they received to X-Forwarded-For (0-3). The public lost-and-found
# form's rate limit (5 reports an hour per client address; an IPv6 client is
# counted per /64) keys on the entry that many places from the RIGHT.
#   - Count every proxy that appends, including a CDN or tunnel edge in front
#     of your own proxy: with an edge and one proxy behind it the number is
#     usually 2, not 1.
#   - It is right only when the entry Nth from the right is one your OUTERMOST
#     trusted proxy wrote. A proxy that does not append but sets the header
#     (or a real-IP header such as X-Real-IP) from something the client can
#     send does not count, and counting it lets a visitor choose their own
#     bucket. A number too high has the same effect: that entry is the visitor's.
#   - Leave it 0 (the default) when the site is reached directly: the header is
#     then ignored. Behind a proxy with 0, everyone shares one limit.
#   - The nginx.conf in this repository passes the header through without
#     adding to it, so it does not count.
#   - Confirm it with a live probe before relying on it: send a request through
#     the public address with a forged X-Real-IP and a forged X-Forwarded-For,
#     and check the limiter's bucket does not change with them (five reports
#     with varying forged values must still stop at the sixth, 429).
TRUST_PROXY_HOPS=

# Optional Telegram Login SSO. Leave all four values empty to keep Telegram
# login disabled. The bot must be an administrator of the configured group so
# it can call getChatMember. TELEGRAM_BOT_USERNAME is the bot's public
# @handle (not secret) — it's what the browser's Login Widget renders with;
# leave it empty and the widget stays hidden even if the other four are set.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_API_BASE_URL=
TELEGRAM_AUTH_MAX_AGE_SECONDS=86400
TELEGRAM_BOT_USERNAME=

# Optional portal-to-trip login. Dedicated server-to-server secret; must differ
# from JWT_SECRET and HERMES_API_KEY. Match the gateway's RUNTIME_EXCHANGE_KEY.
# Unset keeps direct Classic/Modern login and disables portal session minting.
CONTROL_PLANE_EXCHANGE_KEY=
# Default: $TRIP_DIR/control-plane.identity.json. Private identity mapping;
# generated by the control-plane provisioner, never served as trip config.
CONTROL_PLANE_IDENTITY_FILE=
