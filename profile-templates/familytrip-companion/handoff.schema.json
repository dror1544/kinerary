{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FamilyTrip profile handoff v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "handoff_id",
    "trip_ref",
    "source",
    "profile",
    "trip",
    "assistant",
    "organizer",
    "interview"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "profile": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]{2,31}$"
        },
        "description": {
          "type": "string",
          "maxLength": 240
        }
      },
      "additionalProperties": false
    },
    "trip": {
      "type": "object",
      "required": [
        "id",
        "title",
        "default_language",
        "timezone",
        "canonical_site_url"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "default_language": {
          "enum": [
            "he",
            "en"
          ]
        },
        "timezone": {
          "type": "string"
        },
        "canonical_site_url": {
          "type": "string",
          "pattern": "^https?://"
        },
        "site_connection_name": {
          "type": "string"
        },
        "date_start": {
          "type": "string",
          "format": "date"
        },
        "date_end": {
          "type": "string",
          "format": "date"
        }
      },
      "additionalProperties": false
    },
    "assistant": {
      "type": "object",
      "required": [
        "name",
        "gender",
        "tone"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "name_en": {
          "type": "string"
        },
        "gender": {
          "enum": [
            "male",
            "female",
            "neutral"
          ]
        },
        "tone": {
          "enum": [
            "warm",
            "playful",
            "dry"
          ]
        },
        "proactive": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "organizer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "person_ref",
        "display_name"
      ],
      "properties": {
        "person_ref": {
          "type": "string",
          "minLength": 1
        },
        "display_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "co_organizer_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "interview": {
      "type": "object",
      "required": [
        "confirmed",
        "group_safe",
        "organizer_private",
        "participant_needs"
      ],
      "properties": {
        "confirmed": {
          "const": true
        },
        "group_safe": {
          "$ref": "#/$defs/context"
        },
        "organizer_private": {
          "$ref": "#/$defs/context"
        },
        "participant_needs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "person_ref",
              "type",
              "severity",
              "visibility",
              "status",
              "source_answer_ref",
              "text"
            ],
            "properties": {
              "type": {
                "enum": [
                  "dietary",
                  "allergy",
                  "mobility",
                  "accessibility",
                  "medical",
                  "other"
                ]
              },
              "severity": {
                "enum": [
                  "preference",
                  "firm",
                  "critical"
                ]
              },
              "visibility": {
                "enum": [
                  "organizer",
                  "group"
                ]
              },
              "text": {
                "$ref": "#/$defs/bilingual"
              },
              "person_ref": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "const": "confirmed"
              },
              "source_answer_ref": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      },
      "additionalProperties": false
    },
    "record_type": {
      "const": "trip_assistant_profile_input"
    },
    "handoff_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "trip_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "intake_version_ref",
        "intake_schema_version",
        "intake_digest",
        "confirmed_at"
      ],
      "properties": {
        "intake_version_ref": {
          "type": "string",
          "minLength": 1
        },
        "intake_schema_version": {
          "type": "integer",
          "minimum": 1
        },
        "intake_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "confirmed_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  },
  "$defs": {
    "bilingual": {
      "type": "object",
      "required": [
        "he",
        "en"
      ],
      "properties": {
        "he": {
          "type": "string"
        },
        "en": {
          "type": "string"
        }
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "array",
          "string",
          "boolean",
          "object",
          "number",
          "null"
        ]
      }
    }
  }
}
