.env
# No trailing slash: must also match a node_modules *symlink*, not just a real dir (see 8aae012).
node_modules
.DS_Store
.fastembed_cache/
server/data/

# Local runtime state — bot/group state, sqlite DBs, signed payloads.
# Never product source, never a specific trip's data.
/data/

# Per-trip Hermes agent workspaces — always a specific real trip's private
# notes/references, never something to commit.
/workspaces/

# Media assets — stored on NAS, not in git
site/avatars/
site/*.mp3
site/*.wav
site/*.ogg

# Booking confirmation PDFs — deployed via rsync, not git
site/confirmations/
scripts/__pycache__/

# Design references — local only, not committed
references/
scripts/hermes-pipeline/.last-answers.json
.venv-telegram-manager/
provisioning/__pycache__/
tests/provisioning/__pycache__/
telegram_manager/__pycache__/
.hermes-pr3-architecture-review.md
