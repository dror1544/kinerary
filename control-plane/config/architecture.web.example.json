{
  "version": 1,
  "environment": "development",
  "public_api": { "bind_host": "0.0.0.0", "port": 4310 },
  "worker": { "queue": "postgres", "health_bind_host": "127.0.0.1", "health_port": 4311 },
  "database": { "connection_secret_ref": "env://CONTROL_PLANE_DATABASE_URL" },
  "adapters": { "compute": "fake", "ingress": "fake", "agent_runtime": "fake", "messaging": "fake", "secrets": "file" },
  "test_resources": { "enabled": false },
  "web": {
    "public_origin": "http://127.0.0.1:4173",
    "runtime_origin": "http://127.0.0.1:4320",
    "google_client_id": "000000000000-example.apps.googleusercontent.com",
    "runtime_exchange_key_secret_ref": "env://RUNTIME_EXCHANGE_KEY",
    "runtime_upstream_host_suffixes": ["localhost", "internal"],
    "telegram_bot_username": "kinerary_bot",
    "telegram_bot_token_secret_ref": "env://TELEGRAM_BOT_TOKEN",
    "telegram_init_data_max_age_seconds": 300,
    "session_ttl_seconds": 604800,
    "email_provider": "log"
  }
}
