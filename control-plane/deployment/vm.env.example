# control-plane/deployment/vm.env.example — the shape of a control-plane VM's
# env file. Copy it to the deployment repo's checkout on the VM (the running
# stack reads `--env-file /opt/kinerary-deploy/vm.env`) and fill in the values
# THERE, not here.
#
# NO VALUES LIVE IN THIS FILE, by hard rule 6: a second Kinerary on somebody
# else's hardware must not have to edit anything in this repository. This file
# says which variables exist and what each one means; kinerary-deploy says what
# they are for one deployment.
#
# Compose reads this file. A variable written `${X:?...}` in compose.vm.yml is
# REQUIRED — unset, `docker compose` cannot parse the file at all and the whole
# stack fails to come up, rather than starting degraded. Those are marked
# "required" below.
#
# vm.env overrides the shared provisioning.env, because compose takes the last
# --env-file to win.

# ── versions ─────────────────────────────────────────────────────────────────
# Never hand-edit these two. `kinerary-cp-release upgrade|rollback` owns them,
# and it records the way back; editing by hand loses that.
KINERARY_REV=            # required — image tag for api/worker/agent-runtime
HERMES_REV=              # required — image tag for the Hermes fork

# ── the interview's model path ───────────────────────────────────────────────
# Unset is not an error, it is a downgrade: new sessions are created on the
# agent path and the router silently does less. Set the effort too, or a nested
# CLI takes it from whatever settings its HOME has.
INTERPRET_PATH_DEFAULT=  # required — 1 for the agentless router
INTERPRET_RUNNER=        # required — claude | codex | openrouter | hermes
EXTRACT_RUNNER=          # required
INTERPRET_MODEL=
EXTRACT_MODEL=
INTERPRET_EFFORT=        # low|medium|high|xhigh|max — set it explicitly
EXTRACT_EFFORT=

# ── keys ─────────────────────────────────────────────────────────────────────
CONTROL_PLANE_INTERVIEW_AGENT_KEY=   # required
INTERVIEW_MCP_KEY=                   # required
CONTROL_PLANE_CHAT_ROUTING_KEY=
CONTROL_PLANE_OPERATOR_CHAT_ID=

# ── document store ───────────────────────────────────────────────────────────
# Where this host mounts the trips' NFS export. A full VM does NOT inherit the
# Proxmox host's mount the way a trip's LXC does through mp0 — see
# "This VM does not inherit the trips' NFS mount" in
# docs/control-plane-vm-deployment.md.
#
# Do not set this by hand. Run
#   sudo -E scripts/bootstrap-document-store.sh
# with DOCUMENT_STORE_ENV_FILE pointing at this file: it provisions the mount,
# writes the marker, verifies the host against the contract the product
# enforces at runtime, and only then sets this line.
#
# Required once document intake ships: unset, compose cannot parse and the
# stack does not start.
KINERARY_NFS_ROOT=

# ── infrastructure this VM talks to ──────────────────────────────────────────
# All optional here; a deployment that provisions trips needs them.
NPM_URL=
NPM_IDENTITY=
NPM_SECRET=
NPM_API_TOKEN=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
PROVISIONER_COMPANION_SSH_HOST=
PROVISIONER_COMPANION_SSH_KEY=
PROVISIONER_COMPANION_SSH_KNOWN_HOSTS=
PROVISIONER_COMPANION_PROFILE_ENABLED=

# ── host paths ───────────────────────────────────────────────────────────────
KINERARY_REPO_HOST=
KINERARY_DEPLOY_ROOT_HOST=
CONTROL_PLANE_BIND_IP=

# ── safety ───────────────────────────────────────────────────────────────────
# Leave provisioning off unless this stack is meant to create trips. Two stacks
# provisioning onto the same Proxmox/NPM/Cloudflare derive the same slug from
# the same scenario and collide.
CONTROL_PLANE_ALLOW_UNSEALED_RELEASE=
