# control-plane/deployment/vm.env.example — the shape of a control-plane VM's
# env file. Copy it to the deployment repo's checkout on the VM (the running
# stack reads `--env-file /opt/kinerary-deploy/vm.env`) and fill in the values
# THERE, not here.
#
# NO VALUES LIVE IN THIS FILE, by hard rule 6: a second Kinerary on somebody
# else's hardware must not have to edit anything in this repository. This file
# says which variables exist and what each one means; kinerary-deploy says what
# they are for one deployment.
#
# Compose reads this file. A variable written `${X:?...}` in compose.vm.yml is
# REQUIRED — unset, `docker compose` cannot parse the file at all and the whole
# stack fails to come up, rather than starting degraded. Those are marked
# "required" below.
#
# vm.env overrides the shared provisioning.env, because compose takes the last
# --env-file to win.

# ── versions ─────────────────────────────────────────────────────────────────
# Never hand-edit these two. `kinerary-cp-release upgrade|rollback` owns them,
# and it records the way back; editing by hand loses that.
KINERARY_REV=            # required — image tag for api/worker/agent-runtime
HERMES_REV=              # required — image tag for the Hermes fork

# ── the interview's model path ───────────────────────────────────────────────
# Unset is not an error, it is a downgrade: new sessions are created on the
# agent path and the router silently does less. Set the effort too, or a nested
# CLI takes it from whatever settings its HOME has.
INTERPRET_PATH_DEFAULT=  # required — 1 for the agentless router
INTERPRET_RUNNER=        # required — claude | codex | openrouter | hermes
EXTRACT_RUNNER=          # required
INTERPRET_MODEL=
EXTRACT_MODEL=
INTERPRET_EFFORT=        # low|medium|high|xhigh|max — set it explicitly
EXTRACT_EFFORT=
# Photos and scans: unset = never read (a ticket photo then reaches no reservation).
VISION_RUNNER=           # claude | openrouter
VISION_MODEL=
VISION_EFFORT=

# ── keys ─────────────────────────────────────────────────────────────────────
CONTROL_PLANE_INTERVIEW_AGENT_KEY=   # required
INTERVIEW_MCP_KEY=                   # required
CONTROL_PLANE_CHAT_ROUTING_KEY=
# The chat the worker's provisioning notices are queued for (the API sends the matching
# "approved" one to the same place). To keep notices out of the super-admin's own chat, make it
# a group the bot is in (its -100… id) and name `env://CONTROL_PLANE_OPERATOR_CHAT_ID` as
# signup.operator_notices_chat_id_secret_ref in the profile: the API then sends every operator
# notice there and the relay stays silent in it. Unset: notices stay on the super-admin chat.
# kinerary-cp-release reads this same value for its upgrade / rollback / gate notices (a failure
# also goes to the super-admin chat; the gate's approval code never leaves it).
CONTROL_PLANE_OPERATOR_CHAT_ID=

# ── document store ───────────────────────────────────────────────────────────
# Where this host mounts the trips' NFS export. A full VM does NOT inherit the
# Proxmox host's mount the way a trip's LXC does through mp0 — see
# "This VM does not inherit the trips' NFS mount" in
# docs/control-plane-vm-deployment.md.
#
# Do not set this by hand. Run
#   sudo -E scripts/bootstrap-document-store.sh
# with DOCUMENT_STORE_ENV_FILE pointing at this file: it provisions the mount,
# writes the marker, verifies the host against the contract the product
# enforces at runtime, and only then sets this line.
#
# Required once document intake ships: unset, compose cannot parse and the
# stack does not start.
KINERARY_NFS_ROOT=

# ── infrastructure this VM talks to ──────────────────────────────────────────
# All optional here; a deployment that provisions trips needs them.
NPM_URL=
NPM_IDENTITY=
NPM_SECRET=
NPM_API_TOKEN=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
PROVISIONER_COMPANION_SSH_HOST=
PROVISIONER_COMPANION_SSH_KEY=
PROVISIONER_COMPANION_SSH_KNOWN_HOSTS=
PROVISIONER_COMPANION_PROFILE_ENABLED=

# Optional, off when empty. TRIP_MCP_BRIDGE=shared makes the trip-mcp bridge one process for every trip;
# TRIP_MCP_SHARED_SITE_URL is then REQUIRED (and refused without it): the bridge as a trip container reaches
# it, http(s)://<host>:<port>. The bridge must listen on an address containers can reach (MCP_BIND_HOST).
TRIP_MCP_BRIDGE=
TRIP_MCP_SHARED_SITE_URL=
# Optional, lxc when empty: where NEW trips' sites run, lxc | vm-container (a trip's recorded placement always wins).
# vm-container requires TRIP_ROUTING=wildcard and TRIP_MCP_BRIDGE=shared; the worker refuses to start otherwise.
# Spec: docs/specs/sprint-9/x-trip-vm-container-placement.md. Until its worker adapters land, vm-container is refused.
TRIP_PLACEMENT=
# The same shared bridge as the companion host sees it: the routes directory it reads and its loopback URL,
# the two values scripts/companion-install-host.sh takes (set them for its forced command too). Read here by
# kinerary-cp-release: a trip with a route file is verified on the shared bridge with its companion's token,
# and restart-bridges does not start its old per-trip bridge again. Both or neither.
KINERARY_SHARED_BRIDGE_ROUTES_DIR=
KINERARY_SHARED_BRIDGE_URL=

# ── host paths ───────────────────────────────────────────────────────────────
KINERARY_REPO_HOST=
KINERARY_DEPLOY_ROOT_HOST=
CONTROL_PLANE_BIND_IP=

# ── organizer portal and runtime gateway (optional, dark by default) ────────
# Everything in this block is ignored unless COMPOSE_PROFILES names `web`; with
# it unset the stack is exactly the one above. Order of operations, how to
# verify and how to turn it off: "Organizer portal and runtime gateway" in
# docs/control-plane-vm-deployment.md. `kinerary-cp-release` reads
# COMPOSE_PROFILES from this file, so upgrade, verify and rollback follow it.
COMPOSE_PROFILES=                    # `web` switches the two services on
KINERARY_ARCHITECTURE_PROFILE=       # absolute path of the profile WITH a `web` block (architecture.vm-web.example.json is the shape)
PORTAL_ORIGIN=                       # the portal's public https origin; equals web.public_origin in that profile
RUNTIME_ORIGIN=                      # the gateway's public https origin; equals web.runtime_origin; same site as PORTAL_ORIGIN
RUNTIME_EXCHANGE_KEY=                # secret shared by the api and the gateway (and the worker, for trips built from now on). With per-trip keys on it must differ from the master and the legacy key: ROTATE it (docs/runtime-session-exchange.md, "Rolling it out")
RUNTIME_COOKIE_SECRET=               # secret, at least 32 random bytes, independent of every other secret
RUNTIME_TRIP_KEY_MASTER=             # optional, off when empty: per-trip keys. A secret independent of every other (the gateway and worker refuse to start if it equals the exchange key); the gateway and worker hold it, no trip site does
RUNTIME_LEGACY_TRIP_KEY=             # with the master set: the PREVIOUS exchange key, sent only to trips not yet re-keyed; must differ from RUNTIME_EXCHANGE_KEY (the gateway refuses to start otherwise). Empty: such a trip is refused (503), never sent another key
WEB_BIND_IP=                         # interface the ingress reaches both services on (default 127.0.0.1)
PORTAL_PORT=                         # default 4173
RUNTIME_GATEWAY_PORT=                # default 4320
RUNTIME_PUBLIC_SUFFIXES=             # only if the two origins share a domain under a public suffix such as co.uk
RUNTIME_SAME_SITE_OK=                # 1 overrides the same-site check, loudly; avoid
RUNTIME_UPSTREAM_TIMEOUT_MS=
TRIP_HOST_SUFFIX=                    # host mode: the domain trip sites live under (a trip's own <slug>.<suffix> is routed by the gateway once trip-route.py registers it). Empty: off
RELAY_GATEWAY_KEY_MASTER=             # optional (#597 K1): per-gateway relay keys' derivation master, named in the profile as env://RELAY_GATEWAY_KEY_MASTER. Must be a NEW secret no gateway profile has held (never relay_gateway_secret); the relay and companion-mcp refuse to start otherwise
PORTAL_EMAIL_API_KEY=                # only if the profile's web block names env://PORTAL_EMAIL_API_KEY (email sign-up / password reset)

# ── WhatsApp through the relay (optional, off by default) ───────────────────
# Everything in this block is ignored unless WHATSAPP_BRIDGE_ENABLED is on; with it unset the stack is
# exactly the one above and needs no WhatsApp file, secret or variable. On, `kinerary-cp-release`,
# vm-relay-restart.sh and the other compose scripts add compose.vm.whatsapp.yml (the bridge, and two
# secrets for the relay). The two secrets are FILES under .local-secrets/, not variables here. Order of
# operations, pairing, verify, and how to turn it off: "WhatsApp (optional)" in
# docs/control-plane-vm-deployment.md.
# Fill the values in without a trailing comment on the same line.
# WHATSAPP_BRIDGE_ENABLED: 1 | true | yes | on switches it on; anything else (or unset) is off.
WHATSAPP_BRIDGE_ENABLED=
# WHATSAPP_SESSION_DIR: REQUIRED when on. An absolute HOST directory outside every git checkout, mode 0700, owned by uid 1000
# (the bridge's user). It is the logged-in WhatsApp account: in every VM snapshot if it is on the VM's own disk, never in an image.
WHATSAPP_SESSION_DIR=
# WHATSAPP_BRIDGE_PORT: the bridge's loopback port; default 4340. Must equal the port in the profile's relay.whatsapp.bridge_url.
WHATSAPP_BRIDGE_PORT=

# ── safety ───────────────────────────────────────────────────────────────────
# Leave provisioning off unless this stack is meant to create trips. Two stacks
# provisioning onto the same Proxmox/NPM/Cloudflare derive the same slug from
# the same scenario and collide.
CONTROL_PLANE_ALLOW_UNSEALED_RELEASE=
