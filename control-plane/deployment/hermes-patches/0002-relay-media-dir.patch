+# Where a downloaded attachment is saved, when the deployment needs to say.
+#
+# ``download`` hands the agent a filesystem path, so a deployment whose file
+# tools run outside this process — another user, another container — needs the
+# file to land somewhere both sides can open at the same path. That is one
+# directory's worth of a requirement, and it gets one variable. Pointing
+# ``TMPDIR`` at such a directory instead redirects every other temp file the
+# runtime makes — model CLIs, document conversion, dependencies — into a place
+# chosen for media, and when that place is host-persistent (the reason it was
+# named) they outlive the process, and the container, that made them.
+#
+# Unset, or set to something that is not a usable directory, falls back to the
+# default temp dir: a misconfiguration must not silently drop a family's file.
+_MEDIA_DIR_ENV = "HERMES_RELAY_MEDIA_DIR"
+
+
+def media_dir() -> Optional[str]:
+    """The directory ``download`` saves into, or None for the default temp dir."""
+    raw = (os.environ.get(_MEDIA_DIR_ENV) or "").strip()
+    if not raw:
+        return None
+    if not os.path.isdir(raw):
+        logger.warning(
+            "%s=%s is not a directory; saving relay media to the default temp dir",
+            _MEDIA_DIR_ENV, raw,
+        )
+        return None
+    return raw
+
 
 def media_base_url(relay_dial_url: str) -> str:
