+
+# ── Where a downloaded attachment lands ──────────────────────────────────
+#
+# A deployment whose file tools run outside this process — another user, a
+# container — needs the saved file somewhere both sides can see, so it can name
+# one directory for downloaded media. Pointing TMPDIR at that directory instead
+# would send every other temp file in the runtime to a place chosen for this
+# one, and (when that place is host-persistent, which is the reason it was
+# named) leave them there after the process that made them is gone.
+
+
+def _fake_pdf_response(monkeypatch) -> None:
+    import urllib.request
+
+    class _Resp:
+        headers = {"Content-Length": "4", "Content-Type": "application/pdf"}
+
+        def read(self, _n):
+            return b"%PDF"
+
+        def __enter__(self):
+            return self
+
+        def __exit__(self, *a):
+            return False
+
+    monkeypatch.setattr(urllib.request, "urlopen", lambda *a, **kw: _Resp())
+
+
+def _default_temp_dir(monkeypatch, tmp_path: Path) -> Path:
+    """Pin the process default temp dir. TMPDIR would not do: tempfile resolves
+    and caches it once, long before a test could set it."""
+    import tempfile
+
+    default = tmp_path / "default"
+    default.mkdir(exist_ok=True)
+    monkeypatch.setattr(tempfile, "tempdir", str(default))
+    return default
+
+
+def _download(monkeypatch, media_dir: Optional[str]) -> Path:
+    import asyncio
+
+    if media_dir is None:
+        monkeypatch.delenv("HERMES_RELAY_MEDIA_DIR", raising=False)
+    else:
+        monkeypatch.setenv("HERMES_RELAY_MEDIA_DIR", media_dir)
+    client = RelayMediaClient("https://c.example", "gw1", "sec")
+    saved = asyncio.run(client.download("https://c.example/relay/media/abc"))
+    assert saved, "download returned no path"
+    return Path(saved)
+
+
+def test_download_lands_in_the_named_media_dir(monkeypatch, tmp_path: Path):
+    _fake_pdf_response(monkeypatch)
+    default = _default_temp_dir(monkeypatch, tmp_path)
+    shared = tmp_path / "inbound"
+    shared.mkdir()
+
+    saved = _download(monkeypatch, str(shared))
+
+    assert saved.parent == shared, f"saved to {saved}, not the named media dir"
+    assert saved.name.startswith("relay_media_")
+    assert not list(default.iterdir())
+
+
+def test_download_falls_back_to_the_default_temp_dir_when_unset(monkeypatch, tmp_path: Path):
+    _fake_pdf_response(monkeypatch)
+    default = _default_temp_dir(monkeypatch, tmp_path)
+
+    assert _download(monkeypatch, None).parent == default
+
+
+def test_a_media_dir_that_is_not_a_directory_does_not_lose_the_file(monkeypatch, tmp_path: Path):
+    """Misconfiguration degrades to the default temp dir, it does not drop media."""
+    _fake_pdf_response(monkeypatch)
+    default = _default_temp_dir(monkeypatch, tmp_path)
+    not_a_dir = tmp_path / "file.txt"
+    not_a_dir.write_text("not a directory")
+
+    assert _download(monkeypatch, str(not_a_dir)).parent == default
+
+
+def test_the_media_dir_does_not_move_other_temp_files(monkeypatch, tmp_path: Path):
+    """The variable names where MEDIA goes — nothing else in the process."""
+    import os
+    import tempfile
+
+    default = _default_temp_dir(monkeypatch, tmp_path)
+    shared = tmp_path / "inbound"
+    shared.mkdir()
+    monkeypatch.setenv("HERMES_RELAY_MEDIA_DIR", str(shared))
+
+    fd, unrelated = tempfile.mkstemp(prefix="something-else-")
+    os.close(fd)
+
+    assert Path(unrelated).parent == default, (
+        "an unrelated temp file followed the media dir — the redirect is not scoped"
+    )
