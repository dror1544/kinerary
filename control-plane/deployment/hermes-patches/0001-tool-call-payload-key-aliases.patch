+# The schema says ``arguments``, and models do not all agree. gpt-5.6-terra
+# spells it ``parameters`` about half the time; other runtimes use ``args`` or
+# ``input``. Reading only ``arguments`` did not fail loudly — it produced an
+# empty payload, so ``validate_deferred_call_args`` refused the call as missing
+# every required field, handed back the schema, and the model re-sent the same
+# spelling. Live on 2026-09-18 that dropped 49 of one session's 93 dispatches
+# and half a trip's itinerary was never written, while the agent reported the
+# work as done. The key the model picked must not decide whether a call runs.
+_PAYLOAD_KEYS: Tuple[str, ...] = ("arguments", "parameters", "args", "input")
+
+
+def _payload_key(call: Dict[str, Any]) -> str:
+    """Which key of a ``tool_call`` invocation holds the underlying payload.
+
+    ``arguments`` is the documented key and wins whenever it carries anything.
+    An alias is read only when it is the one with content — that keeps a
+    genuinely empty call (``get_config()``) reporting against the documented
+    key, and stops an alias from overriding a payload the model did spell right.
+    """
+    present = [k for k in _PAYLOAD_KEYS if call.get(k) is not None]
+    for key in present:
+        value = call.get(key)
+        if isinstance(value, dict) and value:
+            return key
+        if isinstance(value, str) and value.strip() not in ("", "{}"):
+            return key
+    return present[0] if present else "arguments"
+
