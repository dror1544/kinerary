+class TestRegression_PayloadKeyAliases:
+    """The payload key the model picked must not decide whether a call runs.
+
+    Live 2026-09-18: a companion asked to rewrite a trip's plan issued 93
+    ``tool_call`` dispatches — 44 spelled the payload ``arguments`` and ran,
+    49 spelled it ``parameters`` and were refused as "missing required
+    argument(s) ... The tool was NOT invoked". The probe-validator handed
+    the schema back each time, the model re-sent ``parameters``, and half
+    the itinerary was silently never written. The resolver read one key.
+    """
+
+    @staticmethod
+    def _register(name, required=("phase_id", "text_he")):
+        from tools.registry import registry
+
+        def _handler(args, task_id=None, **kw):
+            return json.dumps({"ok": True, "got": sorted(args)})
+
+        schema = _td(name, f"desc for {name}", {
+            "phase_id": {"type": "string"},
+            "text_he": {"type": "string"},
+            "repo": {"type": "string"},
+        })
+        schema["function"]["parameters"]["required"] = list(required)
+        registry.register(
+            name=name,
+            handler=_handler,
+            schema=schema,
+            toolset="mcp-alias-probe",
+        )
+
+    def test_parameters_alias_survives_the_probe_validator(self):
+        """The exact live shape: {"name", "parameters"} with every field set."""
+        from tools.tool_search import resolve_underlying_call, validate_deferred_call_args
+
+        self._register("mcp_alias_add_plan_item")
+        call = {
+            "name": "mcp_alias_add_plan_item",
+            "parameters": {"phase_id": "tokyo", "text_he": "ביקור במגדל טוקיו סקייטרי"},
+        }
+        name, args, err = resolve_underlying_call(call)
+        assert err is None, err
+        assert args["phase_id"] == "tokyo"
+        assert validate_deferred_call_args(name, args) is None, (
+            "a fully-specified call was still refused as missing arguments"
+        )
+
+    def test_parameters_alias_dispatches_end_to_end(self):
+        import model_tools
+
+        self._register("mcp_alias_dispatch_op")
+        result = json.loads(model_tools.handle_function_call(
+            function_name="tool_call",
+            function_args={"name": "mcp_alias_dispatch_op",
+                           "parameters": {"phase_id": "kyoto", "text_he": "x"}},
+            enabled_toolsets=["mcp-alias-probe"],
+        ))
+        assert result.get("ok") is True
+        assert result.get("got") == ["phase_id", "text_he"]
+
+    def test_json_string_alias_is_parsed(self):
+        from tools.tool_search import resolve_underlying_call
+
+        self._register("mcp_alias_string_op")
+        _, args, err = resolve_underlying_call({
+            "name": "mcp_alias_string_op",
+            "parameters": '{"phase_id": "osaka", "text_he": "y"}',
+        })
+        assert err is None, err
+        assert args == {"phase_id": "osaka", "text_he": "y"}
+
+    def test_args_and_input_aliases_also_resolve(self):
+        from tools.tool_search import resolve_underlying_call
+
+        self._register("mcp_alias_other_keys_op")
+        for key in ("args", "input"):
+            _, args, err = resolve_underlying_call({
+                "name": "mcp_alias_other_keys_op",
+                key: {"phase_id": "hakone", "text_he": "z"},
+            })
+            assert err is None, f"{key}: {err}"
+            assert args["phase_id"] == "hakone", key
+
+    def test_arguments_wins_when_both_carry_a_payload(self):
+        """'arguments' is the documented key; an alias never overrides it."""
+        from tools.tool_search import resolve_underlying_call
+
+        self._register("mcp_alias_both_op")
+        _, args, err = resolve_underlying_call({
+            "name": "mcp_alias_both_op",
+            "arguments": {"phase_id": "tokyo", "text_he": "documented"},
+            "parameters": {"phase_id": "kyoto", "text_he": "alias"},
+        })
+        assert err is None, err
+        assert args["text_he"] == "documented"
+
+    def test_empty_arguments_with_populated_alias_uses_the_alias(self):
+        """Some runtimes emit both, with the real payload under the alias."""
+        from tools.tool_search import resolve_underlying_call
+
+        self._register("mcp_alias_empty_args_op")
+        _, args, err = resolve_underlying_call({
+            "name": "mcp_alias_empty_args_op",
+            "arguments": {},
+            "parameters": {"phase_id": "tokyo4", "text_he": "carried"},
+        })
+        assert err is None, err
+        assert args["text_he"] == "carried"
+
+    def test_genuinely_empty_call_still_resolves_empty(self):
+        """A no-argument tool (get_config()) must keep working."""
+        from tools.tool_search import resolve_underlying_call
+
+        self._register("mcp_alias_no_args_op", required=())
+        _, args, err = resolve_underlying_call({
+            "name": "mcp_alias_no_args_op",
+            "arguments": {},
+        })
+        assert err is None, err
+        assert args == {}
+
+    def test_malformed_alias_names_the_key_it_read(self):
+        from tools.tool_search import resolve_underlying_call
+
+        self._register("mcp_alias_bad_json_op")
+        _, _, err = resolve_underlying_call({
+            "name": "mcp_alias_bad_json_op",
+            "parameters": "{not json",
+        })
+        assert err is not None
+        assert "parameters" in err
