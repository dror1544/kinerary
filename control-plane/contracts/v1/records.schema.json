{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kinerary.invalid/contracts/v1/records.schema.json",
  "title": "Kinerary control-plane canonical records v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "record_type", "id", "created_at"],
  "properties": {
    "schema_version": { "const": 1 },
    "record_type": {
      "enum": [
        "user", "trip", "enrollment", "intake_version", "release", "plan", "job",
        "resource", "verification_evidence", "activation", "organizer_profile",
        "trip_context", "messaging_binding", "connected_service_capability",
        "connected_service_consent", "import_provenance", "audit_event"
      ]
    },
    "id": { "$ref": "#/$defs/id" },
    "created_at": { "$ref": "#/$defs/timestamp" },
    "status": { "type": "string", "minLength": 1 },
    "state": { "type": "string", "minLength": 1 },
    "display_name": { "type": "string", "minLength": 1, "maxLength": 120 },
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "lifecycle_state": { "$ref": "#/$defs/tripState" },
    "current_deployment_id": { "$ref": "#/$defs/id" },
    "trip_id": { "$ref": "#/$defs/id" },
    "user_id": { "$ref": "#/$defs/id" },
    "expires_at": { "$ref": "#/$defs/timestamp" },
    "token_digest": { "$ref": "#/$defs/digest" },
    "version": { "type": "integer", "minimum": 1 },
    "artifact_ref": { "type": "string", "pattern": "^artifact_[A-Za-z0-9]{8,64}$" },
    "digest": { "$ref": "#/$defs/digest" },
    "confirmed_at": { "$ref": "#/$defs/timestamp" },
    "source_revision": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "artifact_digest": { "$ref": "#/$defs/digest" },
    "application_schema": { "type": "integer", "minimum": 1 },
    "data_schema_min": { "type": "integer", "minimum": 1 },
    "data_schema_max": { "type": "integer", "minimum": 1 },
    "kind": { "enum": ["provision", "activate", "upgrade", "rollback", "archive"] },
    "desired_resources": { "type": "array", "items": { "$ref": "#/$defs/slug" } },
    "plan_id": { "$ref": "#/$defs/id" },
    "job_type": { "enum": ["provision", "activate", "upgrade", "rollback", "archive", "cleanup"] },
    "idempotency_key": { "type": "string", "minLength": 8, "maxLength": 200 },
    "correlation_id": { "$ref": "#/$defs/id" },
    "safe_error_code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,63}$" },
    "provider": { "$ref": "#/$defs/slug" },
    "resource_type": { "$ref": "#/$defs/slug" },
    "provider_resource_ref": { "type": "string", "pattern": "^prv_[A-Za-z0-9]{8,64}$" },
    "environment": { "enum": ["test", "development", "production"] },
    "test_run_id": { "type": "string", "pattern": "^tr_[a-z0-9]{8,64}$" },
    "check": { "$ref": "#/$defs/slug" },
    "outcome": { "enum": ["passed", "failed", "skipped"] },
    "evidence_digest": { "$ref": "#/$defs/digest" },
    "approval_id": { "$ref": "#/$defs/id" },
    "organizer_user_id": { "$ref": "#/$defs/id" },
    "profile_ref": { "type": "string", "pattern": "^profile_[A-Za-z0-9]{8,64}$" },
    "policy_bundle_version": { "type": "integer", "minimum": 1 },
    "memory_bundle_version": { "type": "integer", "minimum": 1 },
    "organizer_profile_id": { "$ref": "#/$defs/id" },
    "channel": { "enum": ["private", "group", "admin"] },
    "requester_role": { "enum": ["owner", "organizer", "member", "super_admin", "agent"] },
    "lifecycle": { "$ref": "#/$defs/tripState" },
    "action_families": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/slug" } },
    "bot_ref": { "type": "string", "pattern": "^bot_[A-Za-z0-9]{8,64}$" },
    "chat_ref": { "type": "string", "pattern": "^chat_[A-Za-z0-9]{8,64}$" },
    "valid_from": { "$ref": "#/$defs/timestamp" },
    "valid_until": { "$ref": "#/$defs/timestamp" },
    "supersedes_id": { "$ref": "#/$defs/id" },
    "capability": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]+$" },
    "access_level": { "enum": ["read", "draft", "publish", "transact"] },
    "capability_ids": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/id" } },
    "consented_at": { "$ref": "#/$defs/timestamp" },
    "source_ref": { "type": "string", "pattern": "^source_[A-Za-z0-9]{8,64}$" },
    "source_digest": { "$ref": "#/$defs/digest" },
    "review_status": { "enum": ["pending", "approved", "rejected", "superseded"] },
    "actor_ref": { "$ref": "#/$defs/id" },
    "action": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]+$" },
    "target_ref": { "$ref": "#/$defs/id" },
    "occurred_at": { "$ref": "#/$defs/timestamp" },
    "before_digest": { "$ref": "#/$defs/digest" },
    "after_digest": { "$ref": "#/$defs/digest" }
  },
  "allOf": [
    { "$ref": "#/$defs/user" },
    { "$ref": "#/$defs/trip" },
    { "$ref": "#/$defs/enrollment" },
    { "$ref": "#/$defs/intakeVersion" },
    { "$ref": "#/$defs/release" },
    { "$ref": "#/$defs/plan" },
    { "$ref": "#/$defs/job" },
    { "$ref": "#/$defs/resource" },
    { "$ref": "#/$defs/verificationEvidence" },
    { "$ref": "#/$defs/activation" },
    { "$ref": "#/$defs/organizerProfile" },
    { "$ref": "#/$defs/tripContext" },
    { "$ref": "#/$defs/messagingBinding" },
    { "$ref": "#/$defs/connectedServiceCapability" },
    { "$ref": "#/$defs/connectedServiceConsent" },
    { "$ref": "#/$defs/importProvenance" },
    { "$ref": "#/$defs/auditEvent" }
  ],
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z]{2,12}_[A-Za-z0-9]{8,64}$" },
    "timestamp": { "type": "string", "format": "date-time" },
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "slug": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{1,63}$" },
    "tripState": { "enum": ["pending_signup_approval", "draft", "intake_in_progress", "intake_confirmed", "planned", "provisioning_approved", "provisioning", "ready_private", "activation_approved", "active", "completed", "sealed"] },
    "when": {
      "type": "object",
      "required": ["record_type"],
      "properties": { "record_type": { "type": "string" } }
    },
    "user": { "if": { "properties": { "record_type": { "const": "user" } } }, "then": { "required": ["status", "display_name"], "properties": { "status": { "enum": ["pending", "active", "suspended", "deleted"] } } } },
    "trip": { "if": { "properties": { "record_type": { "const": "trip" } } }, "then": { "required": ["slug", "lifecycle_state"] } },
    "enrollment": { "if": { "properties": { "record_type": { "const": "enrollment" } } }, "then": { "required": ["trip_id", "user_id", "expires_at", "state", "token_digest"], "properties": { "state": { "enum": ["issued", "consumed", "expired", "revoked"] } } } },
    "intakeVersion": { "if": { "properties": { "record_type": { "const": "intake_version" } } }, "then": { "required": ["trip_id", "version", "artifact_ref", "digest", "confirmed_at"] } },
    "release": { "if": { "properties": { "record_type": { "const": "release" } } }, "then": { "required": ["source_revision", "artifact_digest", "application_schema", "data_schema_min", "data_schema_max", "status"], "properties": { "status": { "enum": ["candidate", "verified", "available", "deprecated", "retired"] } } } },
    "plan": { "if": { "properties": { "record_type": { "const": "plan" } } }, "then": { "required": ["trip_id", "kind", "digest", "desired_resources", "status"], "properties": { "status": { "enum": ["draft", "pending_approval", "approved", "superseded", "executed"] } } } },
    "job": { "if": { "properties": { "record_type": { "const": "job" } } }, "then": { "required": ["trip_id", "plan_id", "job_type", "idempotency_key", "correlation_id", "state"], "properties": { "state": { "enum": ["queued", "leased", "running", "waiting", "succeeded", "failed", "cancelled"] } } } },
    "resource": { "if": { "properties": { "record_type": { "const": "resource" } } }, "then": { "required": ["trip_id", "provider", "resource_type", "provider_resource_ref", "environment"], "allOf": [{ "if": { "properties": { "environment": { "const": "test" } } }, "then": { "required": ["test_run_id"] } }] } },
    "verificationEvidence": { "if": { "properties": { "record_type": { "const": "verification_evidence" } } }, "then": { "required": ["trip_id", "check", "outcome", "evidence_digest"] } },
    "activation": { "if": { "properties": { "record_type": { "const": "activation" } } }, "then": { "required": ["trip_id", "plan_id", "approval_id", "state"], "properties": { "state": { "enum": ["pending", "verified", "active", "failed"] } } } },
    "organizerProfile": { "if": { "properties": { "record_type": { "const": "organizer_profile" } } }, "then": { "required": ["organizer_user_id", "profile_ref", "policy_bundle_version", "memory_bundle_version"] } },
    "tripContext": { "if": { "properties": { "record_type": { "const": "trip_context" } } }, "then": { "required": ["trip_id", "organizer_profile_id", "channel", "requester_role", "lifecycle", "action_families", "expires_at"] } },
    "messagingBinding": { "if": { "properties": { "record_type": { "const": "messaging_binding" } } }, "then": { "required": ["provider", "bot_ref", "chat_ref", "trip_id", "organizer_profile_id", "valid_from"] } },
    "connectedServiceCapability": { "if": { "properties": { "record_type": { "const": "connected_service_capability" } } }, "then": { "required": ["provider", "capability", "access_level"] } },
    "connectedServiceConsent": { "if": { "properties": { "record_type": { "const": "connected_service_consent" } } }, "then": { "required": ["user_id", "provider", "capability_ids", "status", "consented_at"], "properties": { "status": { "enum": ["active", "revoked", "expired"] } } } },
    "importProvenance": { "if": { "properties": { "record_type": { "const": "import_provenance" } } }, "then": { "required": ["trip_id", "provider", "source_ref", "source_digest", "review_status"] } },
    "auditEvent": { "if": { "properties": { "record_type": { "const": "audit_event" } } }, "then": { "required": ["actor_ref", "action", "target_ref", "correlation_id", "occurred_at"] } }
  }
}
