{
  "name": "@kinerary/control-plane-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "migrate": "node dist/migrate.js",
    "test": "node --import tsx --test --test-concurrency=1 test/*.test.ts",
    "test:unit": "node --import tsx --test --test-concurrency=1 test/config.test.ts test/contracts.test.ts test/lifecycle.test.ts test/redaction.test.ts test/adapters.test.ts",
    "test:migrations": "node --import tsx --test --test-concurrency=1 test/migrations.test.ts"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "fastify": "^5.6.2",
    "pg": "^8.16.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^20.19.24",
    "@types/pg": "^8.15.6",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
